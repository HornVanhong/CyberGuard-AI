# ==========================================
# CyberGuard AI - Environment Configuration
# ==========================================

# Telegram Bot Credentials (Get from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Authorized Users (Comma-separated Telegram user IDs. Leave empty for public access)
ALLOWED_USER_IDS=

# File Limits (20 MB default for standard Telegram bot API)
MAX_FILE_SIZE_BYTES=20971520

# ClamAV Antivirus Daemon
CLAMAV_ENABLED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30.0

# YARA Pattern Matching
YARA_ENABLED=true
YARA_RULES_DIR=rules
YARA_TIMEOUT=15.0

# VirusTotal Threat Intelligence (Optional)
VIRUSTOTAL_ENABLED=false
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_CACHE_TTL=3600
VIRUSTOTAL_TIMEOUT=15.0

# Google Gemini AI Integration (Official google-genai SDK)
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=25.0
GEMINI_MAX_OUTPUT_TOKENS=1500

# Rate Limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Localization & Audit
DEFAULT_LANGUAGE=en
SCAN_RETENTION_DAYS=30
LOG_LEVEL=INFO

# Cloudflare Worker Telegram Webhook
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here
