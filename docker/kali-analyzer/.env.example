# ==============================================================================
# CyberGuard AI — Kali Malware Analysis Container Environment Variables
# ==============================================================================

# Container Configuration
KALI_CONTAINER_IMAGE=cyberguard-kali-analyzer:latest
KALI_CONTAINER_NAME=cyberguard-kali-analyzer

# Resource Limits
ANALYZER_CPU_LIMIT=2.0
ANALYZER_MEMORY_LIMIT=3000M
ANALYZER_MAX_PROCESSES=150

# Path Mappings on Host
HOST_SAMPLES_DIR=./samples
HOST_REPORTS_DIR=./reports
HOST_LOGS_DIR=./logs

# Optional Components
INSTALL_GHIDRA=true
INSTALL_DIEC=true

# Scanning Timeouts (Seconds)
SCAN_TIMEOUT=45
CLAMAV_TIMEOUT=20
CAPA_TIMEOUT=30
